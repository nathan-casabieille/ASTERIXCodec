<?xml version="1.0" encoding="UTF-8"?>
<Category cat="247" name="Version Number Exchange" edition="1.3" date="2021-08-31">

  <DataItems>

    <DataItem id="010" name="Data Source Identifier" presence="mandatory">
      <Fixed>
        <Element name="SAC" bits="8" encoding="raw"/>
        <Element name="SIC" bits="8" encoding="raw"/>
      </Fixed>
    </DataItem>

    <DataItem id="015" name="Service Identification">
      <Fixed>
        <Element name="SI" bits="8" encoding="raw"/>
      </Fixed>
    </DataItem>

    <!-- TOD: 24-bit unsigned, LSB = 1/128 s -->
    <DataItem id="140" name="Time of Day">
      <Fixed>
        <Element name="TOD" bits="24" encoding="unsigned_quantity" scale="0.0078125" unit="s"/>
      </Fixed>
    </DataItem>

    <!--
      Category Version Number Report.
      Repetitive (1-byte count); each entry: CAT(8)+MAIN(8)+SUB(8) = 3 bytes.
    -->
    <DataItem id="550" name="Category Version Number Report">
      <Repetitive type="count" count_bytes="1">
        <Group>
          <Element name="CAT"  bits="8" encoding="raw"/>
          <Element name="MAIN" bits="8" encoding="raw"/>
          <Element name="SUB"  bits="8" encoding="raw"/>
        </Group>
      </Repetitive>
    </DataItem>

    <DataItem id="RE" name="Reserved Expansion Field">
      <Explicit type="re"/>
    </DataItem>

    <DataItem id="SP" name="Special Purpose Field">
      <Explicit type="sp"/>
    </DataItem>

  </DataItems>

  <!--
    UAP: 7 slots → 1 FSPEC byte
    010 015 140 550 - SP RE
  -->
  <UAPs default="default">
    <Variation name="default">
      <Item ref="010"/>
      <Item ref="015"/>
      <Item ref="140"/>
      <Item ref="550"/>
      <Item ref="-"/>
      <Item ref="SP"/>
      <Item ref="RE"/>
    </Variation>
  </UAPs>

</Category>
