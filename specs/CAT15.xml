            <Element name="CORAR"  bits="8"  encoding="signed_quantity"   scale="0.0078125"/>
            <Element name="CORARR" bits="8"  encoding="signed_quantity"   scale="0.0078125"/>
          </Fixed>
        </SubItem>
      </Compound>
    </DataItem>

    <!-- ══════════════════════════════════════════════════════════════════════
         I015/626 – Doppler Information  (Compound, 10 sub-items, 2 PSF bytes)
         slot 0: DV     (3B: signed 24, 0.01 m/s)
         slot 1: SDDV   (2B: unsigned 16, 1/64 m/s)
         slot 2: DA     (2B: signed 16, 1/64 m/s²)
         slot 3: SDDA   (3B: SDDA(16u,1/64)+CODADV(8s,1/128))
         slot 4: CODVR  (1B: signed 8, 1/128)
         slot 5: CODVRR (1B: signed 8, 1/128)
         slot 6: CODVRA (1B: signed 8, 1/128)
         slot 7: CODAR  (1B: signed 8, 1/128)
         slot 8: CODARR (1B: signed 8, 1/128)
         slot 9: CODARA (1B: signed 8, 1/128)
         ═════════════════════════════════════════════════════════════════════ -->
    <DataItem id="626" name="Doppler Information">
      <Compound>
        <!-- slot 0: DV – Doppler Velocity (3B) -->
        <SubItem name="DV">
          <Fixed>
            <Element name="DV" bits="24" encoding="signed_quantity" scale="0.01" unit="m/s"/>
