        </SubItem>
        <!-- slot 4: RSRR – Range Rate Resolution (3B) -->
        <SubItem name="RSRR">
          <Fixed>
            <Element name="RSRR" bits="24" encoding="unsigned_quantity" scale="0.1" unit="m/s"/>
          </Fixed>
        </SubItem>
        <!-- slot 5: SDRR – Range Rate Precision (4B) -->
        <SubItem name="SDRR">
          <Fixed>
