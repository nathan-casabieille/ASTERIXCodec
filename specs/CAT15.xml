        </SubItem>
        <!-- slot 9: CODARA – Correlation of DA and Range Acceleration (1B) -->
        <SubItem name="CODARA">
          <Fixed>
            <Element name="CODARA" bits="8" encoding="signed_quantity" scale="0.0078125"/>
          </Fixed>
        </SubItem>
      </Compound>
    </DataItem>

    <!-- ══════════════════════════════════════════════════════════════════════
         I015/627 – Azimuth Information  (Compound, 6 sub-items, 1 PSF byte)
         slot 0: AZ    (2B: unsigned 16, 360/2^16 °)
         slot 1: RSAZ  (2B: unsigned 16, 45/2^16 °)
         slot 2: SDASZ (2B: unsigned 16, 45/2^16 °)
         slot 3: AZR   (2B: signed 16, 180/2^16 °/s)
