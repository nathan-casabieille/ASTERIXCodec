      </Compound>
    </DataItem>

    <!-- ══════════════════════════════════════════════════════════════════════
         I015/625 – Range Information  (Compound, 8 sub-items, 2 PSF bytes)
         slot 0: R    (3B: signed 24, 0.1 m)
         slot 1: RSR  (3B: unsigned 24, 0.1 m)
         slot 2: SDR  (3B: unsigned 24, 0.1 m)
         slot 3: RR   (3B: signed 24, 0.1 m/s)
         slot 4: RSRR (3B: unsigned 24, 0.1 m/s)
         slot 5: SDRR (4B: SDRR(24u,0.1)+CORRR(8s,1/128))
         slot 6: RA   (2B: signed 16, 1/64 m/s²)
         slot 7: SDRA (4B: SDRA(16u,1/128)+CORAR(8s,1/128)+CORARR(8s,1/128))
         ═════════════════════════════════════════════════════════════════════ -->
    <DataItem id="625" name="Range Information">
      <Compound>
        <!-- slot 0: R – Range (3B) -->
