        <!-- slot 4: CODVR – Correlation of Doppler Velocity and Range (1B) -->
        <SubItem name="CODVR">
          <Fixed>
            <Element name="CODVR" bits="8" encoding="signed_quantity" scale="0.0078125"/>
          </Fixed>
        </SubItem>
        <!-- slot 5: CODVRR – Correlation of DV and Range Rate (1B) -->
        <SubItem name="CODVRR">
          <Fixed>
            <Element name="CODVRR" bits="8" encoding="signed_quantity" scale="0.0078125"/>
          </Fixed>
        </SubItem>
        <!-- slot 6: CODVRA – Correlation of DV and Range Acceleration (1B) -->
        <SubItem name="CODVRA">
          <Fixed>
            <Element name="CODVRA" bits="8" encoding="signed_quantity" scale="0.0078125"/>
          </Fixed>
        </SubItem>
        <!-- slot 7: CODAR – Correlation of Doppler Acceleration and Range (1B) -->
        <SubItem name="CODAR">
